<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: block cleartext (already enforced by targetSdk >= 28) -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Certificate pinning for official Solar Network domains -->
    <!--
    IMPORTANT: Replace the placeholder SHA-256 hashes below with the actual
    certificate hashes from the production servers.

    To extract the SHA-256 hash of a certificate:
      echo | openssl s_client -connect solian.app:443 -servername solian.app 2>/dev/null \
        | openssl x509 -pubkey -noout \
        | openssl pkey -pubin -outform der \
        | openssl dgst -sha256 -binary \
        | openssl enc -base64

    The official instance uses Let's Encrypt. Pin the intermediate or leaf
    certificate hash, NOT the root CA, to allow for certificate rotation.
    -->
    <domain-config>
        <domain includeSubdomains="true">solian.app</domain>
        <pin-set>
            <!-- TODO: Replace with actual production certificate SHA-256 hash -->
            <pin digest="SHA-256">PLACEHOLDER_SOLIAN_APP_CERT_HASH</pin>
        </pin-set>
    </domain-config>

    <domain-config>
        <domain includeSubdomains="true">nt.solian.app</domain>
        <pin-set>
            <!-- TODO: Replace with actual production certificate SHA-256 hash -->
            <pin digest="SHA-256">PLACEHOLDER_NT_SOLIAN_APP_CERT_HASH</pin>
        </pin-set>
    </domain-config>

    <!-- Allow user-configured servers (no pinning) for self-hosted instances -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
    </domain-config>
</network-security-config>

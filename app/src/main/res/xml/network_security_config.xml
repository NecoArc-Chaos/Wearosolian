<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: block cleartext (already enforced by targetSdk >= 28) -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Certificate pinning is disabled until real hashes are provided.
         To enable, uncomment the domain-config blocks below and replace
         the placeholder hashes with actual SHA-256 SPKI hashes. -->
    <!--
    <domain-config>
        <domain includeSubdomains="true">solian.app</domain>
        <pin-set>
            <pin digest="SHA-256">REAL_HASH_HERE</pin>
        </pin-set>
    </domain-config>

    <domain-config>
        <domain includeSubdomains="true">nt.solian.app</domain>
        <pin-set>
            <pin digest="SHA-256">REAL_HASH_HERE</pin>
        </pin-set>
    </domain-config>
    -->

    <!-- Allow user-configured servers (no pinning) for self-hosted instances -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
    </domain-config>
</network-security-config>
